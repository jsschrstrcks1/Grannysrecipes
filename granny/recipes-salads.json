      "ingredients": [
        {
          "item": "mixed vegetables",
          "quantity": "1",
          "unit": "can (16 oz)",
          "prep_note": "drained"
        },
        {
          "item": "boiled potato",
          "quantity": "1",
          "unit": "",
          "prep_note": "diced"
        },
        {
          "item": "sliced celery",
          "quantity": "1/2",
