    {
      "id": "lime-coconut-salad-granny",
      "collection": "granny",
      "collection_display": "Granny Hudson",
      "title": "Lime Coconut in Pineapple",
      "category": "salads",
      "description": "A refreshing lime gelatin salad with pineapple and coconut.",
      "ingredients": [
        {
          "item": "lime gelatin (Jello)",
          "quantity": "1",
          "unit": "3 oz package"
        },
        {
          "item": "boiling water",
          "quantity": "1-1/2",
          "unit": "cups"
        },
        {
          "item": "crushed pineapple",
          "quantity": "1",
          "unit": "cup",
          "prep_note": "drained, reserve juice"
        },
        {
          "item": "pineapple juice",
          "quantity": "1",
          "unit": "cup",
          "prep_note": "from drained pineapple"
        },
        {
          "item": "shredded coconut",
          "quantity": "1/2",
          "unit": "cup"
        },
        {
          "item": "cottage cheese",
          "quantity": "1",
          "unit": "cup",
          "prep_note": "[UNCLEAR]"
        },
        {
          "item": "Cool Whip or whipped cream",
          "quantity": "1",
          "unit": "cup",
          "prep_note": "[UNCLEAR]"
        }
      ],
      "instructions": [
        {
          "step": 1,
          "text": "Dissolve gelatin in boiling water. Stir until dissolved."
        },
        {
          "step": 2,
          "text": "Add pineapple juice. Chill until partially set."
        },
        {
          "step": 3,
          "text": "Fold in drained pineapple and coconut."
        },
        {
          "step": 4,
          "text": "Add remaining ingredients and mix well."
        },
        {
          "step": 5,
          "text": "Pour into mold or dish."
        },
        {
          "step": 6,
          "text": "Refrigerate until firm."
        }
      ],
      "tags": [
