      "collection": "granny",
      "collection_display": "Granny Hudson",
      "title": "Garden Leaf Salad",
      "category": "salads",
      "prep_time": "10 min",
      "servings_yield": "4 servings",
      "ingredients": [
        {
          "item": "Butterhead lettuce",
          "quantity": "1",
          "unit": "head"
        },
        {
          "item": "radishes",
          "quantity": "1",
          "unit": "bunch",
          "prep_note": "sliced"
        },
        {
          "item": "eggs",
          "quantity": "3",
          "unit": "",
          "prep_note": "hard-boiled, chopped"
        },
        {
          "item": "black pepper",
          "quantity": "",
          "unit": "",
          "prep_note": "optional"
        }
      ],
      "instructions": [
        {
          "step": 1,
          "text": "To prepare dressing, in a small bowl, whisk together all ingredients. Blend well. Cover bowl with plastic wrap. Chill."
        },
        {
          "step": 2,
          "text": "Gently tear lettuce. Place in a large serving bowl. Add radishes and eggs."
        },
        {
          "step": 3,
          "text": "Pour dressing over salad. Toss. Season with pepper, if desired."
        }
      ],
      "notes": [
        "For best flavor, serve this salad slightly chilled. Any member of the Butterhead lettuce family is fine for this recipe. Varieties include Bibb, Boston and Buttercrunch. Recipe may be halved or doubled."
