        },
        {
          "item": "parsley",
          "quantity": "",
          "unit": "",
          "prep_note": "for garnish"
        }
      ],
      "instructions": [
        {
          "step": 1,
          "text": "In a bowl, combine canned vegetables, potato, celery and onion. Toss lightly."
        },
        {
          "step": 2,
          "text": "To prepare dressing, in separate bowl, combine mayonnaise, lemon juice, salt and pepper. Mix well."
        },
        {
          "step": 3,
          "text": "Add dressing to vegetables. Toss gently. Cover. Chill for at least 1 hour."
        },
        {
          "step": 4,
          "text": "On a serving platter or in a bowl, mound salad. Surround with beets. Garnish with parsley."
        }
