          "quantity": "1/2",
          "unit": "tsp"
        }
      ],
      "instructions": [
        {
          "step": 1,
          "text": "In saucepan, heat oil and 1 tablespoon butter. Add onion. Saut\u00e9 over low heat until limp but not brown, about 5 minutes."
