        {
          "step": 5,
          "text": "Spread mixture into a buttered 9- or 10-inch round, shallow baking dish. Dot with remaining butter."
        },
        {
          "step": 6,
          "text": "Bake at 375\u00b0F for 30 to 40 minutes until top is browned. Serve immediately."
        }
      ],
