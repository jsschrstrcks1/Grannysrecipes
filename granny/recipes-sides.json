      "title": "Easy Potato Gratin",
      "category": "sides",
      "prep_time": "20 min",
      "cook_time": "30-40 min",
      "servings_yield": "4 servings",
      "temperature": "375\u00b0F (190\u00b0C)",
      "ingredients": [
        {
          "item": "medium potatoes",
