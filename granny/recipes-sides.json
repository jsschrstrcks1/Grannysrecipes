        {
          "item": "garlic",
          "quantity": "1",
          "unit": "clove",
          "prep_note": "minced or pressed"
        },
        {
          "item": "eggs",
          "quantity": "4",
          "unit": ""
        },
        {
          "item": "fresh parsley, minced fresh chives and dried chervil leaves",
          "quantity": "2",
          "unit": "tbsp each"
        },
        {
          "item": "shredded Jarlsberg or Swiss cheese",
          "quantity": "3/4",
          "unit": "cup"
        },
        {
          "item": "whipping cream or milk",
          "quantity": "1/4",
          "unit": "cup"
