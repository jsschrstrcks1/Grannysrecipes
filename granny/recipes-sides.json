      "source_note": "My Great Recipes packet",
      "description": "An easy corn souffl\u00e9 that puffs up golden brown.",
      "temperature": "425\u00b0F (220\u00b0C)",
      "prep_time": "10 minutes",
      "cook_time": "20 minutes",
      "servings_yield": "6 servings",
      "ingredients": [
        {
          "item": "eggs",
          "quantity": "4",
          "unit": "",
          "prep_note": "room temperature"
        },
        {
          "item": "creamed-style corn",
          "quantity": "1",
          "unit": "can (1 lb)"
        },
        {
          "item": "butter or margarine",
          "quantity": "1/4",
          "unit": "cup",
          "prep_note": "melted"
        },
        {
          "item": "all-purpose flour",
          "quantity": "1",
          "unit": "tbsp"
        },
        {
          "item": "granulated sugar",
          "quantity": "2/3",
          "unit": "cup"
        },
        {
          "item": "milk",
          "quantity": "1",
          "unit": "cup"
        },
        {
          "item": "baking powder",
          "quantity": "1",
          "unit": "tbsp"
        },
        {
          "item": "salt and white pepper",
          "quantity": "",
          "unit": "",
          "prep_note": "dash each"
        },
        {
          "item": "red or green pepper slices",
          "quantity": "",
          "unit": "",
          "prep_note": "for garnish, optional"
        }
      ],
      "instructions": [
        {
          "step": 1,
          "text": "In stainless steel bowl, beat eggs lightly. Stir in corn, salt, pepper, butter, flour, sugar and milk. Beat until well mixed."
        },
        {
          "step": 2,
          "text": "Add baking powder. Mix well."
        },
        {
          "step": 3,
          "text": "Spoon into buttered 1-cup souffl\u00e9 dishes. Place on cookie sheet."
        },
        {
          "step": 4,
          "text": "Bake at 425\u00b0F for 20 minutes or until puffed and golden brown."
        },
        {
          "step": 5,
          "text": "Garnish with pepper slices, if used. Serve immediately."
        }
      ],
