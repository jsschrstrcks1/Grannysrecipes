    {
      "id": "pizza-horns-granny",
      "collection": "granny",
      "collection_display": "Granny Hudson",
      "title": "Pizza Horns",
      "category": "appetizers",
      "prep_time": "30-35 min",
      "cook_time": "15 min",
      "servings_yield": "16",
      "temperature": "450\u00b0F (230\u00b0C)",
      "ingredients": [
        {
          "item": "frozen bread dough",
          "quantity": "2",
          "unit": "loaves (1 lb each)"
        },
        {
          "item": "olive oil",
          "quantity": "",
          "unit": ""
        },
        {
          "item": "all-purpose flour",
          "quantity": "",
          "unit": ""
        },
        {
          "item": "pizza oregano leaves",
          "quantity": "1",
          "unit": "jar (14 oz)",
          "prep_note": "dried"
        },
        {
          "item": "garlic powder",
          "quantity": "1",
          "unit": "tsp"
        },
        {
          "item": "grated Mozzarella",
          "quantity": "1 1/2",
          "unit": "lbs"
        },
        {
          "item": "Parmesan cheese",
          "quantity": "1/2",
          "unit": "cup"
        },
        {
          "item": "green pepper",
          "quantity": "1",
          "unit": "cup",
          "prep_note": "minced or chopped"
        },
        {
          "item": "pepperoni",
          "quantity": "2-3",
          "unit": "oz",
          "prep_note": "minced or chopped"
        },
        {
          "item": "lightly beaten oregano",
          "quantity": "1/4",
          "unit": "cup",
          "prep_note": "white, dried"
        },
        {
          "item": "Parmesan cheese",
          "quantity": "",
          "unit": "",
          "prep_note": "additional"
        }
      ],
      "instructions": [
        {
          "step": 1,
          "text": "To thaw dough, refrigerate overnight or let stand at room temperature for 2 to 3 hours."
        },
        {
          "step": 2,
          "text": "On a lightly floured surface, roll each loaf into a 10-inch circle or pat and stretch with hands until 1/4-inch thick. Brush surface with oil."
        },
        {
          "step": 3,
          "text": "With a pizza cutter or sharp knife, cut each circle into 8 triangular wedges."
        },
        {
          "step": 4,
          "text": "Combine sauce, oregano and garlic powder. Spread on top of wedges, leaving about 1/4-inch margin on each side."
        },
        {
          "step": 5,
          "text": "Sprinkle with cheeses, green pepper and pepperoni. Roll up, each triangle beginning from wide end. Curve ends to form crescents."
        },
        {
          "step": 6,
          "text": "Place on lightly oiled baking sheets. Brush tops with egg white. Sprinkle with additional oregano and/or Parmesan cheese."
        },
        {
          "step": 7,
          "text": "Bake at 450\u00b0F for 15 minutes or until golden brown."
        }
      ],
      "notes": [
        "Health Note: Using frozen wheat bread dough adds extra nutrition to this recipe. Tips: You may vary the filling according to taste. Try toppings such as mushrooms or onions."
      ],
