      "id": "easy-guacamole-granny",
      "collection": "granny",
      "collection_display": "Granny Hudson",
      "title": "Easy Guacamole",
      "category": "appetizers",
      "source_note": "Publix Aprons recipe card",
      "description": "Simple and delicious guacamole.",
      "prep_time": "15 minutes",
      "total_time": "45 minutes",
      "servings_yield": "6 servings",
      "ingredients": [
        {
          "item": "ripe avocados",
          "quantity": "2",
          "unit": "",
          "prep_note": "pitted and peeled"
        },
        {
          "item": "small onion",
          "quantity": "1/2",
          "unit": "",
          "prep_note": "finely chopped"
        },
        {
          "item": "fresh lime juice",
          "quantity": "2",
          "unit": "tbsp"
        },
        {
          "item": "fresh cilantro leaves",
          "quantity": "2",
          "unit": "tbsp",
          "prep_note": "finely chopped"
        },
        {
          "item": "garlic",
          "quantity": "1",
          "unit": "clove",
          "prep_note": "minced"
        },
        {
          "item": "medium tomato",
          "quantity": "1",
          "unit": "",
          "prep_note": "coarsely chopped"
        },
        {
          "item": "salt",
          "quantity": "1/4",
          "unit": "tsp"
        },
        {
          "item": "pepper",
          "quantity": "",
          "unit": "",
          "prep_note": "to taste"
        }
      ],
      "instructions": [
        {
          "step": 1,
          "text": "Place avocados in bowl and sprinkle with lime juice, salt, and pepper; mash with fork until desired texture."
        },
        {
          "step": 2,
          "text": "Stir remaining ingredients into avocados. Chill 30 minutes for flavors to blend or until ready to serve."
        }
      ],
      "notes": [
        "Other preparation methods: Bake - Preheat oven to 400\u00b0F. Cut 1 ripe, peeled avocado into 8 wedges; place in baking dish. Coat with 1 tablespoon each: salt, oil and 1/4 teaspoon each: salt, pepper, and red pepper. Bake 20-25 minutes or until edges are golden. Sprinkle with 1 teaspoon fresh lime juice. Sauce: Place 2 ripe, peeled avocados into food processor bowl; add 1 tablespoon fresh lime juice, 1 1/2 cups fresh cilantro, 1/4 cup sour cream, and 1/2 teaspoon total seasoning. Process until smooth. Serve over chicken, beef, or pork."
      ],
