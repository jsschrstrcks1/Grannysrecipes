      "id": "sausage-stuffed-mushrooms-granny",
      "collection": "granny",
      "collection_display": "Granny Hudson",
      "title": "Sausage-Stuffed Mushrooms",
      "category": "appetizers",
      "source_note": "My Great Recipes packet",
      "description": "Large mushroom caps stuffed with seasoned pork sausage.",
      "temperature": "400\u00b0F (200\u00b0C)",
      "prep_time": "15 minutes",
      "cook_time": "25-30 minutes",
      "servings_yield": "16 mushrooms",
      "ingredients": [
        {
          "item": "breakfast-style seasoned pork sausage",
          "quantity": "1",
          "unit": "lb"
        },
        {
          "item": "large white mushrooms",
          "quantity": "16",
          "unit": "",
          "prep_note": "cleaned"
        },
        {
          "item": "salt and black pepper",
          "quantity": "",
          "unit": "",
          "prep_note": "to taste"
        },
        {
          "item": "chopped parsley",
          "quantity": "",
          "unit": "",
          "prep_note": "for garnish"
        }
      ],
      "instructions": [
        {
          "step": 1,
          "text": "In a medium bowl, place sausage."
        },
        {
          "step": 2,
          "text": "Remove stems from mushrooms. Finely chop stems. Mix with sausage. Place mushroom caps on baking pan with top-sides down."
        },
        {
          "step": 3,
          "text": "Divide sausage mixture into 16 portions. Shape into balls. Place one ball into each mushroom cap."
        },
        {
          "step": 4,
          "text": "Sprinkle tops lightly with salt and pepper."
        },
        {
          "step": 5,
          "text": "Bake at 400\u00b0F for 15 to 20 minutes until sausage is browned and cooked through."
        },
        {
          "step": 6,
          "text": "Garnish with parsley. Serve immediately."
        }
      ],
      "notes": [
        "Good served with: Herbed rice pilaf and a tossed salad to make a light supper.",
        "Tips: To clean mushrooms, gently rinse in cold water and pat dry.",
        "Variations: You may substitute bulk Italian or Polish sausage for the breakfast-style sausage. For variety, serve mushrooms on buttered toast or tomato slices."
      ],
