      "servings_yield": "4 servings",
      "ingredients": [
        {
          "item": "oil",
          "quantity": "1",
          "unit": "tbsp"
        },
        {
          "item": "beef round or stew meat",
          "quantity": "1",
          "unit": "lb"
        },
        {
          "item": "small onion",
          "quantity": "1",
          "unit": "",
          "prep_note": "minced"
        },
        {
