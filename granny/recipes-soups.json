        },
        {
          "item": "black pepper",
          "quantity": "1/4",
          "unit": "tsp"
        },
        {
          "item": "barley",
          "quantity": "1/2",
          "unit": "cup"
        },
        {
          "item": "water",
          "quantity": "4",
          "unit": "cans (10 1/2 oz each)",
          "prep_note": "or beef broth"
        },
        {
          "item": "tomatoes",
          "quantity": "1",
          "unit": "can (8 1/2 oz)"
        },
        {
          "item": "mushrooms",
          "quantity": "2",
          "unit": "",
          "prep_note": "medium, sliced"
        },
        {
          "item": "carrots",
          "quantity": "2",
