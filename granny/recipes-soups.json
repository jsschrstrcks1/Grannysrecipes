        },
        {
          "item": "shredded Edam cheese",
          "quantity": "1",
          "unit": "cup"
        }
      ],
      "instructions": [
        {
          "step": 1,
          "text": "Cut beef into small 1/2-inch wide strips. In a heavy 3-quart saucepan, heat oil. Add meat. Lightly brown onion. Saut\u00e9 3-4 minutes."
        },
        {
          "step": 2,
          "text": "Add salt, pepper, barley, if used, parsley, broth, water and tomatoes. Bring to a boil."
        },
        {
          "step": 3,
          "text": "Cover. Simmer for 30 minutes."
        },
        {
          "step": 4,
          "text": "To prepare croutons, toss bread cubes with butter. Sprinkle with Edam, stirring after 5 minutes."
        },
        {
          "step": 5,
          "text": "Ladle soup into bowls. Top with croutons."
        }
      ],
      "notes": [
        "Tips: For added flavor, other vegetables such as potatoes, green beans, peas, celery or parsnips may be added to soup.",
        "Cheese Croutons: 1 cup fresh bread cubes, 1 Tbsp butter or margarine, \u00bc cup shredded Edam cheese. Melt butter in skillet. Add bread cubes. Cook 15 to 20 minutes until golden, stirring occasionally. Sprinkle with cheese."
