    {
      "id": "markys-blue-eyed-muffins-granny",
      "collection": "granny",
      "collection_display": "Granny Hudson",
      "title": "Marky's Blue-Eyed Muffins",
      "category": "breakfast",
      "source_note": "My Great Recipes packet",
      "description": "Blueberry muffins with a cinnamon crumble topping.",
      "temperature": "400\u00b0F (200\u00b0C)",
      "prep_time": "15 minutes",
      "cook_time": "20 minutes",
      "servings_yield": "10 muffins",
      "ingredients": [
        {
          "item": "butter or margarine",
          "quantity": "1/4",
          "unit": "cup"
        },
        {
          "item": "granulated sugar",
          "quantity": "3",
          "unit": "tbsp"
        },
        {
          "item": "brown sugar",
          "quantity": "3",
          "unit": "tbsp"
        },
        {
          "item": "egg",
          "quantity": "1",
          "unit": "",
          "prep_note": "slightly beaten"
        },
        {
          "item": "all-purpose flour",
          "quantity": "1-1/2",
          "unit": "cups"
        },
        {
          "item": "baking powder",
          "quantity": "1-1/2",
          "unit": "tsp"
        },
        {
          "item": "salt",
          "quantity": "1/2",
          "unit": "tsp",
          "prep_note": "optional"
        },
        {
          "item": "milk",
          "quantity": "3/4",
          "unit": "cup"
        },
        {
          "item": "fresh or frozen blueberries",
          "quantity": "1",
          "unit": "cup"
        }
      ],
      "instructions": [
        {
          "step": 1,
          "text": "In a large bowl, cream together butter and sugars until light. Beat in egg."
        },
        {
          "step": 2,
          "text": "In a medium bowl, combine flour, baking powder and salt. Alternately with milk, add to creamed mixture. Do not over-mix."
        },
        {
          "step": 3,
          "text": "Fold in blueberries. Spoon mixture into greased muffin pans."
        },
        {
          "step": 4,
          "text": "To prepare topping, combine sugar, flour and cinnamon. Cut in butter."
        },
        {
          "step": 5,
          "text": "Sprinkle topping evenly over muffin batter."
        },
        {
          "step": 6,
          "text": "Bake at 400\u00b0F for 20 minutes. Cool for 1 minute. Remove from pans."
        }
      ],
      "notes": [
        "Good served with fresh pineapple and hot coffee or tea."
      ],
      "tags": [
        "breakfast",
        "muffins",
        "blueberry",
        "crumble topping"
      ],
