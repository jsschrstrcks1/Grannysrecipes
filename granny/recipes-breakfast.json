    {
      "id": "spiced-blueberry-jam-granny",
      "collection": "granny",
      "collection_display": "Granny Hudson",
      "title": "Spiced Blueberry Jam",
      "category": "breakfast",
      "source_note": "My Great Recipes packet",
      "description": "Homemade blueberry jam with warm spices.",
      "prep_time": "10 minutes",
      "cook_time": "1 minute",
      "servings_yield": "4 cups",
      "ingredients": [
        {
          "item": "fresh blueberries",
          "quantity": "3",
          "unit": "cups",
          "prep_note": "or 1 pkg (1 lb) frozen blueberries, thawed"
        },
        {
          "item": "lemon juice",
          "quantity": "1",
          "unit": "tbsp"
        },
        {
          "item": "granulated sugar",
          "quantity": "3-1/2",
          "unit": "cups"
        },
        {
          "item": "cinnamon",
          "quantity": "1",
          "unit": "tsp"
        },
        {
          "item": "ground cloves",
          "quantity": "1/4",
          "unit": "tsp"
        },
        {
          "item": "allspice",
          "quantity": "1/4",
          "unit": "tsp"
        },
        {
          "item": "liquid pectin",
          "quantity": "1",
          "unit": "pouch"
        },
        {
          "item": "melted paraffin",
          "quantity": "",
          "unit": "",
          "prep_note": "for sealing"
        }
      ],
      "instructions": [
        {
          "step": 1,
          "text": "Remove any stems from berries. Crush fruit, 1/2 cup at a time. Measure 2-1/4 cups, packed solidly. If necessary, add water to make up amount. Pour into very large saucepan or Dutch oven."
        },
        {
          "step": 2,
          "text": "Add lemon juice, sugar and spices. Mix well. Bring to a rolling boil (a boil that can't be stirred down). Boil 1 minute. Remove from heat. Immediately stir in pectin."
        },
        {
          "step": 3,
          "text": "Ladle into hot jelly glasses or jars. Pour 1/8-inch hot paraffin over top. Paraffin should cling to sides of jars and contain no air bubbles."
        },
        {
          "step": 4,
          "text": "Cover with lids. Store in cool, dry place."
        }
      ],
      "notes": [
        "Tips: If using fresh blueberries, carefully rinse under cold running water, drain and plump berries."
      ],
      "tags": [
        "breakfast",
        "jam",
        "blueberry",
        "preserves",
        "canning"
      ],
