      "id": "maple-pecan-waffles-granny",
      "collection": "granny",
      "collection_display": "Granny Hudson",
      "title": "Maple Pecan Waffles",
      "category": "breakfast",
      "prep_time": "15 min",
      "cook_time": "1-2 min per waffle",
      "servings_yield": "4 servings",
      "ingredients": [
        {
          "item": "all-purpose flour",
          "quantity": "1 1/2",
          "unit": "cups"
        },
        {
          "item": "baking powder",
          "quantity": "1",
          "unit": "tsp"
        },
        {
          "item": "salt",
          "quantity": "1/4",
          "unit": "tsp"
        },
        {
          "item": "egg yolks",
          "quantity": "2",
          "unit": ""
        },
        {
          "item": "milk",
          "quantity": "2/3",
          "unit": "cup"
        },
        {
          "item": "vegetable oil",
          "quantity": "1/4",
          "unit": "cup"
        },
        {
          "item": "egg whites",
          "quantity": "2",
          "unit": ""
        },
        {
          "item": "chopped pecans",
          "quantity": "3/4",
          "unit": "cup"
        },
        {
          "item": "maple-flavored extract",
          "quantity": "1/2",
          "unit": "tsp"
        },
        {
          "item": "fresh strawberries",
          "quantity": "",
          "unit": "",
          "prep_note": "for garnish"
        }
      ],
      "instructions": [
        {
          "step": 1,
          "text": "In bowl, sift together flour, baking powder and salt."
        },
        {
          "step": 2,
          "text": "In mixing bowl, beat together egg yolks, milk and oil until combined. Gradually add flour mixture, beating after each addition. Beat only until smooth."
        },
        {
          "step": 3,
          "text": "In small bowl, beat egg whites until stiff peaks form. Fold whites into batter. Stir in pecans and maple extract."
        },
        {
          "step": 4,
          "text": "For each waffle, pour up to 3/4 cup batter into center of waffle iron until it spreads to 1 inch from edges."
        },
        {
          "step": 5,
          "text": "Cook until waffle iron stops steaming. Waffle should be crisp and golden. Serve immediately."
        },
        {
          "step": 6,
          "text": "Garnish with sliced strawberries. Serve with warmed maple syrup and melted butter."
        }
      ],
      "notes": [
        "Any leftover waffles can be frozen. Wrap tightly in plastic wrap or seal in a plastic bag and freeze. Reheat frozen waffles in toaster."
      ],
