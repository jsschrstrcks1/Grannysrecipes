      "instructions": [
        {
          "step": 1,
          "text": "Black and White Ice Cream Soda: In tall glass, pour milk. Top with syrup and a scoop of ice cream. Fill with soda water. Garnish with chocolate curls."
        },
        {
          "step": 2,
          "text": "Coffee Ice Cream Soda: In tall glass, pour milk. Add syrup and a scoop of ice cream. Fill with soda water."
        },
        {
          "step": 3,
          "text": "Lemon Ice Cream Soda: In tall glass, pour milk and lemonade. Add a scoop of ice cream. Fill with soda water."
        },
        {
          "step": 4,
          "text": "Fruity Ice Cream Soda: In tall glass, place fruit puree, milk and a scoop of ice cream. Fill with soda water."
        },
        {
          "step": 5,
          "text": "Coffee Syrup: In sauce pan, mix 1 cup granulated sugar, 1 cup light corn syrup and 1 1/2 cups water. Bring to a boil, stirring constantly. Remove from heat. Stir in 1/4 cup instant coffee and 1 teaspoon vanilla extract. Keep refrigerated."
        }
