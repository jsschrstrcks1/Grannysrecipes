    {
      "id": "easy-croissants-granny",
      "collection": "granny",
      "collection_display": "Granny Hudson",
      "title": "Easy Croissants",
      "category": "breads",
      "source_note": "My Great Recipes packet",
      "description": "Buttery, flaky croissants with optional chocolate, apple-almond, or other fillings.",
      "temperature": "375\u00b0F (190\u00b0C)",
      "prep_time": "15 minutes",
      "cook_time": "10-15 minutes",
      "servings_yield": "32 croissants",
      "ingredients": [
        {
          "item": "active dry yeast",
          "quantity": "2",
          "unit": "packages"
        },
        {
          "item": "warm water",
          "quantity": "1/2",
          "unit": "cup",
          "prep_note": "105-115\u00b0F"
        },
        {
          "item": "nonfat dry milk",
          "quantity": "1",
          "unit": "cup"
        },
        {
          "item": "granulated sugar",
          "quantity": "1-1/2",
          "unit": "tbsp"
        },
        {
          "item": "salt",
          "quantity": "1",
          "unit": "tsp"
        },
        {
          "item": "all-purpose flour",
          "quantity": "5",
          "unit": "cups"
        },
        {
          "item": "firm butter or margarine",
          "quantity": "1",
          "unit": "cup"
        },
        {
          "item": "eggs",
          "quantity": "1",
          "unit": "cup"
        }
      ],
      "instructions": [
        {
          "step": 1,
          "text": "In bowl, dissolve yeast in water. Add milk, salt, eggs and 1 cup flour. Beat until smooth. Blend in melted butter."
        },
        {
          "step": 2,
          "text": "In large bowl with food processor, place remaining flour. Cut in butter slices until butter is size of kidney beans."
        },
        {
          "step": 3,
          "text": "Pour yeast mixture. Blend just until flour is moistened. Cover. Chill 2 to 48 hours."
        },
        {
          "step": 4,
          "text": "Cut dough into quarters. Dust one quarter at a time. Roll into a circle 16-inches in diameter. Cut into 8 wedges. Repeat with remaining dough."
        },
        {
          "step": 5,
          "text": "Place filling, if used, on wide ends. Roll up each toward point. Shape into crescents. Place on ungreased baking sheet. Let rise 2 hours. Brush with egg."
        },
        {
          "step": 6,
          "text": "Bake at 375\u00b0F 10 to 15 minutes until golden."
        }
      ],
      "notes": [
        "Chocolate filling: Place 2 tablespoons of chocolate chips on wide end of wedge. Apple-Almond filling: Combine 1/2 cup almond paste and 3/4 cup applesauce. Spoon 2 tablespoons on wide end of wedge."
      ],
      "tags": [
        "bread",
        "croissants",
        "yeast",
        "pastry"
      ],
