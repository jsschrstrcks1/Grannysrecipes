#!/bin/bash
# Pre-commit hook for Granny's Recipe Archive
# Ensures anti-indexing measures are always in place
#
# To install: git config core.hooksPath .githooks

REPO_ROOT="$(git rev-parse --show-toplevel)"

# Required-hooks guard — runs on EVERY commit, including merges (must precede any
# merge-skip logic below). See .githooks/check-required-hooks.sh.
if [ -x "$REPO_ROOT/.githooks/check-required-hooks.sh" ]; then
    "$REPO_ROOT/.githooks/check-required-hooks.sh" || exit 1
fi

# Run anti-indexing check
if [ -f "$REPO_ROOT/scripts/check-noindex.sh" ]; then
    bash "$REPO_ROOT/scripts/check-noindex.sh"
    if [ $? -ne 0 ]; then
        echo ""
        echo "Commit blocked: Anti-indexing requirements not met."
        echo "This is a private family archive - we must prevent search engine indexing."
        exit 1
    fi
fi

# Run recipe validation if available
if [ -f "$REPO_ROOT/scripts/validate-recipes.py" ]; then
    echo ""
    echo "Running recipe validation..."
    python3 "$REPO_ROOT/scripts/validate-recipes.py" 2>/dev/null
    # Don't block on validation warnings, only errors
fi


# Reasoning log — the RUNTIME-INDEPENDENT half. Injection hooks only reach agents
# whose harness runs Claude Code hooks; every runtime commits. Blocks a substantive
# commit with no reasoning entry dated today. Opt out per-commit with [no-reasoning].
if [ -x "$REPO_ROOT/.githooks/reasoning-log-guard.sh" ]; then
  "$REPO_ROOT/.githooks/reasoning-log-guard.sh" || exit 1
fi
exit 0
